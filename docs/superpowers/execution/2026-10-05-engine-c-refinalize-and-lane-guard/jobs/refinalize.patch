+        return decline("the recorded commit %r is not a full hex SHA" % (commit,))
+    merged = rec.get("merged") or []
+    if not isinstance(merged, list) or sorted(rec.get("jobs") or []) != sorted(job_ids) \
+            or sorted(merged) != sorted(job_ids):
