+            json.dump(state, fh, ensure_ascii=False)
+        res = _jev_run(["build", "--point", point, "--state-file", tmp, "--repo", repo,
+                        "--context", "offline"])
+    finally:
+        try:
+            os.remove(tmp)
+        except OSError:
+            pass
+    if res and res.get("status") == "ok" and isinstance(res.get("request_file"), str):
+        return res["request_file"]
+    return None
