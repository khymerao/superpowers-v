+def _jev_defaults_copy():
+    """A fresh copy of ``JEV_DEFAULTS``, nested point dicts included."""
+    values = dict(JEV_DEFAULTS)
+    for point, _modes in _JEV_POINTS:
+        values[point] = dict(JEV_DEFAULTS[point])
+    return values
+
+
+def _valid_confidence(v):
+    """True for a number in (0, 1]. A bool is rejected (it is an int subclass) and NaN
+    fails the range test on its own."""
+    return (isinstance(v, (int, float)) and not isinstance(v, bool)
+            and 0 < v <= 1)
+
+
+def resolve_jev(cfg):
+    """Return ``(values, warnings)``: the effective ``jev`` config with every missing or
+    invalid key coerced to its declared default, plus human-readable warnings for the
+    caller to surface once. Mirrors ``resolve_pre_eval`` and NEVER raises, whatever it is
+    handed. ``t3.mode: "active"`` is coerced to ``"shadow"`` with a warning: active T3 is
+    spec 1.5. Unknown keys are ignored, as ``resolve_pre_eval`` ignores them.
+    """
+    values = _jev_defaults_copy()
+    warnings = []
+    raw = {}
+    if isinstance(cfg, dict) and "jev" in cfg:
+        if isinstance(cfg["jev"], dict):
+            raw = cfg["jev"]
+        else:
+            warnings.append("jev must be an object; using defaults")
+
+    if "enabled" in raw:
+        v = raw["enabled"]
+        if isinstance(v, bool):
+            values["enabled"] = v
+        else:
+            warnings.append("jev.enabled must be true/false; using default %r"
+                            % JEV_DEFAULTS["enabled"])
+
+    if "model" in raw:
+        v = raw["model"]
+        if isinstance(v, str) and v.strip():
+            values["model"] = v
+        else:
+            warnings.append("jev.model must be a non-empty string; using default %r"
+                            % JEV_DEFAULTS["model"])
+
+    for point, modes in _JEV_POINTS:
+        if point not in raw:
+            continue
+        block = raw[point]
+        if not isinstance(block, dict):
+            warnings.append("jev.%s must be an object; using defaults" % point)
+            continue
+        default = JEV_DEFAULTS[point]
+
+        if "mode" in block:
+            v = block["mode"]
+            if isinstance(v, str) and v in modes:
+                values[point]["mode"] = v
+            elif point == "t3" and v == "active":
+                warnings.append("jev.t3.mode 'active' is not available until spec 1.5; "
+                                "using 'shadow'")
+            else:
+                warnings.append("jev.%s.mode must be one of %s; using default %r"
+                                % (point, modes, default["mode"]))
+
+        if "confidence_min" in block:
+            v = block["confidence_min"]
+            if _valid_confidence(v):
+                values[point]["confidence_min"] = float(v)
+            else:
+                warnings.append("jev.%s.confidence_min must be a number in (0, 1]; "
+                                "using default %r" % (point, default["confidence_min"]))
+
+        if point == "t3" and "calibrated_model" in block:
+            v = block["calibrated_model"]
+            if v is None or (isinstance(v, str) and v.strip()):
+                values["t3"]["calibrated_model"] = v
+            else:
+                warnings.append("jev.t3.calibrated_model must be null or a non-empty "
+                                "string; using default None")
+
+    return values, warnings
+
+
