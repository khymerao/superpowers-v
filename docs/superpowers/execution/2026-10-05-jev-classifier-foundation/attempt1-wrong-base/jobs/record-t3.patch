+        "needs_t3": bool(res.get("needs_t3")),
+        "record_ref": res.get("record_ref"),
+        "predicates": [],
+        "declared_paths": [],
+        "refused_paths": list(res.get("refused_paths") or []),
+        "session_id": sid,
+        "base_commit": base,
+        "disabled": bool(res.get("pre_eval_disabled")),
+        "member": False,
