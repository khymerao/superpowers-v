+                snap_bytes = fh.read()
+            snap_digest = tax.taxonomy_digest_bytes(snap_bytes)
+            taxonomy = tax.load_taxonomy(text=snap_bytes.decode("utf-8", "replace"))
+        except (OSError, ValueError, RuntimeError):
