+def _mini_schema_ok(value, sub):
+    """A stdlib reading of the small JSON-Schema subset the record's `t3` block uses (type,
+    enum, required, properties, additionalProperties, minimum, maximum, maxLength). The
+    selftest runs where `jsonschema` is absent too, and a schema row that is skipped there
+    proves nothing, so the `t3` rows read the SHIPPED schema through this instead."""
+    if not isinstance(sub, dict):
+        return False
+    typ = sub.get("type")
+    if typ == "object":
+        if not isinstance(value, dict):
+            return False
+        if any(k not in value for k in sub.get("required", [])):
+            return False
+        props = sub.get("properties", {})
+        extra = sub.get("additionalProperties", True)
+        for k, v in value.items():
+            if k in props:
+                if not _mini_schema_ok(v, props[k]):
+                    return False
+            elif extra is False:
+                return False
+            elif isinstance(extra, dict) and not _mini_schema_ok(v, extra):
+                return False
+    elif typ == "string":
+        if not isinstance(value, str):
+            return False
+        if "maxLength" in sub and len(value) > sub["maxLength"]:
+            return False
+    elif typ == "number":
+        if isinstance(value, bool) or not isinstance(value, (int, float)):
+            return False
+        if "minimum" in sub and value < sub["minimum"]:
+            return False
+        if "maximum" in sub and value > sub["maximum"]:
+            return False
+    elif typ is not None:
+        return False
+    if "enum" in sub and value not in sub["enum"]:
+        return False
+    return True
+
