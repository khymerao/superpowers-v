+def _jev_defaults_copy():
+    """A deep copy of ``JEV_DEFAULTS`` so a caller can never mutate module state."""
+    values = dict(JEV_DEFAULTS)
+    for block in ("t3", "detect_ui", "onboard"):
+        values[block] = dict(JEV_DEFAULTS[block])
+    return values
+
+
+def _jev_confidence(raw, block, values, warnings):
+    """Apply ``<block>.confidence_min`` from ``raw`` when it is a number in (0, 1]."""
+    if "confidence_min" not in raw:
+        return
+    v = raw["confidence_min"]
+    # bool is an int subclass in Python: a JSON `true` must not read as 1.0.
+    # NaN fails both comparisons, so it falls through to the default as well.
+    if isinstance(v, (int, float)) and not isinstance(v, bool) and 0 < v <= 1:
+        values[block]["confidence_min"] = float(v)
+    else:
+        warnings.append("jev.%s.confidence_min must be a number in (0, 1]; using default %r"
+                        % (block, JEV_DEFAULTS[block]["confidence_min"]))
+
+
+def _jev_mode(raw, block, allowed, values, warnings):
+    """Apply ``<block>.mode`` from ``raw`` when it is one of ``allowed``."""
+    if "mode" not in raw:
+        return
+    v = raw["mode"]
+    if block == "t3" and v == "active":
+        warnings.append("jev.t3.mode 'active' is not available until spec 1.5; using 'shadow'")
+        values["t3"]["mode"] = "shadow"
+    elif isinstance(v, str) and v in allowed:
+        values[block]["mode"] = v
+    else:
+        warnings.append("jev.%s.mode must be one of %s; using default %r"
+                        % (block, allowed, JEV_DEFAULTS[block]["mode"]))
+
+
+def _resolve_jev_inner(cfg, values, warnings):
+    raw = {}
+    if isinstance(cfg, dict) and "jev" in cfg:
+        if isinstance(cfg["jev"], dict):
+            raw = cfg["jev"]
+        else:
+            warnings.append("jev must be an object; using defaults")
+
+    # enabled: bool
+    if "enabled" in raw:
+        v = raw["enabled"]
+        if isinstance(v, bool):
+            values["enabled"] = v
+        else:
+            warnings.append("jev.enabled must be true/false; using default %r"
+                            % JEV_DEFAULTS["enabled"])
+
+    # model: non-empty string
+    if "model" in raw:
+        v = raw["model"]
+        if isinstance(v, str) and v.strip():
+            values["model"] = v
+        else:
+            warnings.append("jev.model must be a non-empty string; using default %r"
+                            % JEV_DEFAULTS["model"])
+
+    for block, allowed in (("t3", _JEV_T3_MODES), ("detect_ui", _JEV_SURFACE_MODES),
+                           ("onboard", _JEV_SURFACE_MODES)):
+        if block not in raw:
+            continue
+        sub = raw[block]
+        if not isinstance(sub, dict):
+            warnings.append("jev.%s must be an object; using defaults" % block)
+            continue
+        _jev_mode(sub, block, allowed, values, warnings)
+        _jev_confidence(sub, block, values, warnings)
+        # t3.calibrated_model: null or a non-empty string.
+        if block == "t3" and "calibrated_model" in sub:
+            v = sub["calibrated_model"]
+            if v is None or (isinstance(v, str) and v.strip()):
+                values["t3"]["calibrated_model"] = v
+            else:
+                warnings.append("jev.t3.calibrated_model must be null or a non-empty string; "
+                                "using default None")
+
+
+def resolve_jev(cfg):
+    """Return ``(values, warnings)``: the effective ``jev`` config with every
+    missing/invalid key coerced to its declared default, plus human-readable warnings
+    for the caller to surface once. Mirrors ``resolve_pre_eval`` and NEVER raises:
+    any unexpected failure returns the full defaults with one warning.
+
+    ``t3.mode`` is ``off|shadow`` in spec 1; ``active`` is coerced to ``shadow`` with
+    a warning naming spec 1.5. This block is committed team policy only: the
+    OpenRouter key and the egress consent live in the vault plugin, never here.
+    """
+    values = _jev_defaults_copy()
+    warnings = []
+    try:
+        _resolve_jev_inner(cfg, values, warnings)
+    except Exception:  # never raise: degrade to the declared defaults
+        return _jev_defaults_copy(), ["jev config could not be read; using defaults"]
+    return values, warnings
+
+
